# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Прокси только для Telegram, если api.telegram.org недоступен напрямую. Happ: http://127.0.0.1:10809
TELEGRAM_PROXY=

# --- Расписание ---
CHECK_INTERVAL_MINUTES=60
# false: первый скан молча индексирует выдачу, уведомления — только о новых
INITIAL_SCAN_NOTIFY=false

# --- Avito ---
# Формат: Метка|URL;Метка|URL   (метка попадает в уведомление, например "Мужское")
# s=104 — "сначала новые", pmax — цена до. Свой URL: настрой фильтры на avito.ru и скопируй адрес.
AVITO_SEARCH_URLS=Одежда/обувь|https://www.avito.ru/all/odezhda_obuv_aksessuary?q=dolce+gabbana&s=104&pmax=2000
AVITO_PROFILE_PATH=./data/avito_profile
# Российский прокси только для браузера Avito (резидентный/мобильный, НЕ дата-центр). Пусто = напрямую.
# Формат: http://логин:пароль@host:port  (socks5://... тоже можно, но без логина/пароля)
AVITO_PROXY=
HEADLESS=false
MAX_PAGES=3

# --- Правило мониторинга (локальная перепроверка поверх выдачи Avito) ---
RULE_NAME=Dolce & Gabbana <= 2000
# D&G можно дописать сюда — но будет много мусора
KEYWORDS=dolce gabbana,dolce & gabbana,dolce&gabbana,dolce gabana,dolce gabanna,дольче габбана,дольче и габбана,дольче габана
EXCLUDE_KEYWORDS=реплика,копия,люкс,lux,premium,aaa,1:1,под оригинал,как оригинал,качество оригинала,replica
PRICE_MIN=0
PRICE_MAX=2000

# --- Проверка рынка (/report) ---
# REPORT_SECTIONS= — slug'и разделов через запятую; по умолчанию 25 разделов TOP из кода
REPORT_MAX_SUBCATS=18
REPORT_MAX_PAGES=5
REPORT_MAX_AGE_DAYS=7
MIN_PRICE=10000
VPD_MIN=50
VPD_HOT=100
REPORT_CARDS_PER_SUBCAT=12
REPORT_BUDGET=600
REPORT_RESUME_HOURS=12
# Капча во время /report: бот шлёт алерт и ждёт, пока ты пройдёшь её в окне браузера (нужен HEADLESS=false), N минут
CAPTCHA_WAIT_MINUTES=15
CHECK_SELLER_DATE=true
PAGE_DELAY_MIN=2
PAGE_DELAY_MAX=5

# --- Прочее ---
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO
